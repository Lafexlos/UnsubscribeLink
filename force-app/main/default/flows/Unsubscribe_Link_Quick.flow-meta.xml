        <connector>
            <targetReference>Check_Link_Exists</targetReference>
        </connector>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Unsubscribe_Link_Setup__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Confirmation_Page__c</queriedFields>
        <queriedFields>Enable_Type_in_Email_Address__c</queriedFields>
        <queriedFields>Send_Confirmation_Email__c</queriedFields>
        <queriedFields>Screen_1_Part_1__c</queriedFields>
        <queriedFields>Screen_1_Part_2__c</queriedFields>
        <queriedFields>Screen_2_Part_1__c</queriedFields>
        <queriedFields>Screen_2_Part_2__c</queriedFields>
        <queriedFields>Screen_3__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <screens>
        <description>confirmation screen for person to confirm they want to unsubscribe. Update &quot;our organization&quot; in the custom metadata type &quot;Unsubscribe Link.&quot;</description>
        <name>Are_you_sure</name>
